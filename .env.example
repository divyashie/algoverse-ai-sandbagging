# Copy this to .env and fill in. The .env file is git-ignored.
#
# Or, better, source these from your shell's startup file (~/.zshrc
# etc.) so they're available in every terminal.

# HuggingFace access token. Required for gated models (Llama, Gemma).
# Get one at https://huggingface.co/settings/tokens — read access is
# enough; you only need write if you plan to push adapters.
HF_TOKEN=

# Google Gemini API key. Required for the judge model (used by
# shared/judging.py and red_team/trigger_attack/pipeline.py error
# generation). Free tier rate-limits at 10 RPM but the pipeline has
# retry logic.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: where HuggingFace caches model weights. Default is
# ~/.cache/huggingface. If your home is on a small disk, point this
# at a roomier mount.
# HF_HOME=/path/with/lots/of/disk

# Optional: pytorch MPS fallback. Set to 1 if you hit "MPS doesn't
# implement op X" errors. Only relevant on Mac when forced to use HF
# (the MLX runner doesn't need this).
# PYTORCH_ENABLE_MPS_FALLBACK=1
